# 로컬: 아래 값을 infra/.env 로 복사해 사용 (로컬 compose는 생략하면 기본값 blog/blog/blog)
# 운영 compose(docker-compose.prod.yml)는 POSTGRES_PASSWORD가 필수다 (비우면 실행 전에 실패)
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=

# 서버(prod)에서 추가로 필요
# JWT 서명 키(Base64, 디코딩 32바이트 이상): openssl rand -base64 32
JWT_SECRET=
# 관리자 계정: prod 필수(비우면 기동 실패). local은 로그인할 때만 셸·IDE 환경변수로 지정
# (password 12자 이상, username 50자 이하)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 이미지 태그: 비우면 latest. 로컬 빌드 확인은 셸에서 IMAGE_TAG=local 로 덮어쓴다
IMAGE_TAG=
